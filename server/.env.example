# Copy to .env and fill in. .env is gitignored and must never be committed.
# Both docker-compose and the Spring app read these, so there is one source of truth.
POSTGRES_DB=reellab
POSTGRES_USER=reellab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
# Host port for Postgres. 5432 is often already taken by another project's
# container, so ReelLab defaults to 5433. Both compose (host side of the port
# mapping) and the app's JDBC URL read this, so they cannot drift apart.
POSTGRES_PORT=5433

# Where media is served from. Only the relative path is stored in the database;
# this base is prepended when building responses.
# Point at the r2.dev public URL once scripts/media/upload.sh has run.
MEDIA_CDN_BASE_URL=http://localhost:8080/media

# Signing key for the auth tokens. HS256 needs at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-of-random
