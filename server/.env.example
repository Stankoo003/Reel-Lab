# Copy to .env and fill in. .env is gitignored and must never be committed.
# Variable names match the Spring backend's where one existed, so an old .env still works.

# Postgres. Locally: the docker-compose Postgres (see POSTGRES_* below, which only compose reads).
# Deployed: the Neon POOLED connection string (the one with "-pooler" in the host).
DATABASE_URL=postgresql://reellab:change-me-locally@localhost:5433/reellab
POSTGRES_DB=reellab
POSTGRES_USER=reellab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5433

# Signing key for the auth tokens. HS256 needs at least 32 bytes. Keep the SAME value the
# Spring backend used and every existing session stays valid.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-of-random
# How long a session lasts.
JWT_TTL=30d

# --- Media -------------------------------------------------------------------
# THE KILL SWITCH.
#   off     → every upload refused with 403 before a byte can reach storage
#   avatars → only avatars (default): capped by AVATAR_MAX_BYTES, and a replaced one is deleted,
#             so each user occupies at most one avatar's worth of the bucket
#   on      → clips and posters too
# Feed, likes, comments, messages all work with clips off.
MEDIA_UPLOADS=avatars
# Largest avatar accepted, in bytes.
AVATAR_MAX_BYTES=524288
# local → files on MEDIA_STORAGE_DIR, uploaded through this server, served at /media/**.
#         Development only: a serverless filesystem does not persist.
# r2    → Cloudflare R2. The client uploads straight to the bucket with a URL this server signs.
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=../media
# Where media is served from. Only the relative path is stored in the database; this base is
# prepended when building responses. Local: this server. R2: the bucket's public URL
# (https://pub-….r2.dev or a custom domain). Must equal EXPO_PUBLIC_MEDIA_BASE_URL in the app.
MEDIA_CDN_BASE_URL=http://localhost:3000/media
# Largest video/poster accepted, in bytes (avatars are capped at 512KB regardless).
MEDIA_MAX_BYTES=268435456
# Only when MEDIA_STORAGE=r2. An API token with Object Read & Write on the bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=reellab-media

# --- Email -------------------------------------------------------------------
# smtp → Mailpit from docker compose (read the mailbox at http://localhost:8025)
# resend → the deployed environment.
MAIL_PROVIDER=smtp
MAIL_FROM=ReelLab <no-reply@reellab.dev>
MAIL_HOST=localhost
MAIL_PORT=1025
# Only used when MAIL_PROVIDER=resend. Resend refuses any From on a domain you have not verified.
RESEND_API_KEY=

# Where a reset link points — this server's own public URL. Locally the link is opened on the
# PHONE, so localhost only works on the iOS simulator; a device needs the Mac's LAN address.
# Deployed: https://<project>.vercel.app
PUBLIC_BASE_URL=http://localhost:3000

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_TTL=45m
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_WINDOW=15m
PASSWORD_RESET_FLOOR=250ms

# --- Direct messages ---------------------------------------------------------
DM_SEND_LIMIT=20
DM_SEND_WINDOW=1m
DM_PAGE_SIZE=30
