# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Encoded media — regenerate with scripts/media/encode.sh
/media/

# The 15MB spike fixture. Nothing loads it — it was a scratch clip for the capability
# spike — and a binary that size lives in git history forever once committed.
assets/spike/sample.mp4

# Local environment. Ignore every .env variant, but keep the committed templates.
.env
.env.*
!.env.example
!.env.production.example
scripts/media/.env.r2
