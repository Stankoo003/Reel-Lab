# Copy to .env. Expo loads .env, .env.local, .env.development and .env.production
# automatically, and inlines EXPO_PUBLIC_* at build time. Restart the bundler after
# changing these — they are compiled in, not read at runtime.
#
# Never put secrets behind EXPO_PUBLIC_: the values are visible in the shipped bundle.

EXPO_PUBLIC_APP_ENV=development

# localhost only resolves on the iOS simulator. A physical device needs the Mac's LAN
# IP (this machine: 192.168.10.207), or `adb reverse tcp:8080 tcp:8080` on Android.
EXPO_PUBLIC_API_BASE_URL=http://192.168.10.207:8080

# Must match MEDIA_CDN_BASE_URL in server/.env.
EXPO_PUBLIC_MEDIA_BASE_URL=http://192.168.10.207:8090

