{
  "CORSRules": [
    {
      "AllowedOrigins": ["*"],
      "AllowedMethods": ["GET", "HEAD"],
      "AllowedHeaders": ["Range", "Content-Type"],
      "ExposeHeaders": [
        "Content-Length",
        "Content-Range",
        "Accept-Ranges",
        "Content-Type",
        "ETag"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
