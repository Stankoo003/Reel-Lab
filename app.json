{
  "expo": {
    "name": "ReelLab",
    "slug": "ReelLab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.reellab.spike",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E0F12",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "dev.reellab.spike",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "ReelLab needs the camera to record clips.",
          "microphonePermission": "ReelLab needs the microphone to record audio.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ReelLab saves exported clips to your library.",
          "savePhotosPermission": "ReelLab saves exported clips to your library.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ReelLab needs your library to pick a source clip."
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "@nikhil-cephei/ffmpeg-kit-react-native",
        {
          "subspec": "full-gpl"
        }
      ],
      "expo-dev-client",
      "./plugins/withSigning",
      "expo-router"
    ],
    "newArchEnabled": true,
    "scheme": "reellab",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "615b072d-9aec-4561-b8e6-f1be97094256"
      }
    }
  }
}
