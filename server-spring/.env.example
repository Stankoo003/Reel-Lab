# Copy to .env and fill in. .env is gitignored and must never be committed.
# Both docker-compose and the Spring app read these, so there is one source of truth.
POSTGRES_DB=reellab
POSTGRES_USER=reellab
POSTGRES_PASSWORD=change-me-locally
POSTGRES_HOST=localhost
# Host port for Postgres. 5432 is often already taken by another project's
# container, so ReelLab defaults to 5433. Both compose (host side of the port
# mapping) and the app's JDBC URL read this, so they cannot drift apart.
POSTGRES_PORT=5433

# Where media is served from. Only the relative path is stored in the database;
# this base is prepended when building responses.
# Point at the r2.dev public URL once scripts/media/upload.sh has run.
MEDIA_CDN_BASE_URL=http://localhost:8080/media

# Signing key for the auth tokens. HS256 needs at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-bytes-of-random

# --- Email -------------------------------------------------------------------
# smtp → Mailpit from docker compose (read the mailbox at http://localhost:8025)
# resend → the deployed environment. Nothing in the code differs; see MailConfig.
MAIL_PROVIDER=smtp
MAIL_FROM=ReelLab <no-reply@reellab.dev>
MAIL_HOST=localhost
MAIL_PORT=1025
# Only used when MAIL_PROVIDER=resend. Resend refuses any From on a domain you have not
# verified with them, which is the usual first failure when deploying this.
RESEND_API_KEY=

# Where a reset link points — this server's own public URL. The email cannot link straight
# to reellab:// because a custom scheme is a dead link for anyone without the app.
# The link is opened on the PHONE, so localhost only works on the iOS simulator; a physical
# device needs the Mac's LAN address, the same host as EXPO_PUBLIC_API_BASE_URL in the
# root .env (e.g. http://192.168.10.207:8080).
PUBLIC_BASE_URL=http://localhost:8080

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_TTL=45m
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_IP_LIMIT=10
PASSWORD_RESET_WINDOW=15m

# --- Direct messages ---------------------------------------------------------
# Per user per window, not per conversation — the abuse this stops is one account
# firing at anybody.
DM_SEND_LIMIT=20
DM_SEND_WINDOW=1m
DM_PAGE_SIZE=30
